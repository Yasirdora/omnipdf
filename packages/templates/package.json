{
  "name": "@omnipdf/templates",
  "version": "0.1.0",
  "description": "Document templates for OmniPDF \u2014 invoice, and later CV, report, screenplay, paper. Templates map data to layout blocks: document types are data, not code.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "invoice",
    "templates",
    "pdf",
    "documents"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "dependencies": {
    "@omnipdf/core": "0.1.0",
    "@omnipdf/document": "0.1.0",
    "@omnipdf/einvoice": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OmniPDF/omnipdf.git",
    "directory": "packages/templates"
  },
  "homepage": "https://github.com/OmniPDF/omnipdf/tree/main/packages/templates",
  "bugs": {
    "url": "https://github.com/OmniPDF/omnipdf/issues"
  }
}
